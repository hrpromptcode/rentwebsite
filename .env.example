# ---- Database (PostgreSQL) ----
# App connection (RLS enforced through `app_user` role via SET LOCAL ROLE)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rentweb
# Admin connection used for migrations and seeding (falls back to DATABASE_URL)
DATABASE_ADMIN_URL=
# Role the app switches to inside every tenant transaction (must NOT have BYPASSRLS)
DB_APP_ROLE=app_user

# ---- Platform ----
# Root domain. Tenants live at {slug}.{PLATFORM_ROOT_DOMAIN}. For local dev use "localhost:3000".
PLATFORM_ROOT_DOMAIN=localhost:3000
ADMIN_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ---- Cache (optional; falls back to in-memory) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Media storage (Cloudflare R2 / S3). Optional in dev: falls back to local ./uploads ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rentweb-media
R2_PUBLIC_URL=

# ---- Secrets encryption (32 bytes base64) for tenant API keys ----
SECRETS_ENCRYPTION_KEY=

# ---- Notifications / worker ----
RESEND_API_KEY=
EMAIL_FROM="RentWeb <noreply@rentweb.app>"
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=RentWeb
# protects POST /api/internal/outbox (cron)
INTERNAL_SECRET=
# dev: auto-approve uploaded slips so flows complete without an admin
DEV_AUTO_APPROVE_SLIPS=true

# ---- LINE Login for storefront customers ----
# Each shop's Channel ID / Channel secret live encrypted in tenant_secrets (admin: Settings > LINE Login); nothing global here.
# Dev-only mock provider (apps/web/src/app/api/dev/line-mock/**), served when NODE_ENV !== production AND LINE_MOCK=1.
LINE_MOCK=
# Override LINE's endpoints (defaults: https://access.line.me for authorize, https://api.line.me for token/verify/profile).
# For the mock set both to http://localhost:3000/api/dev/line-mock (the storefront calls the token endpoint from Node).
LINE_OAUTH_BASE=
LINE_API_BASE=
